# Manufacturer CAD and photographs are byte-pinned source artifacts.
# Preserve original line endings and avoid treating STEP/STL as source-code diffs.
web/platform/assets/**/source*.step binary
web/platform/assets/**/source*.stp binary
web/platform/assets/**/source*.stl binary
web/platform/assets/**/source*.obj binary
web/platform/assets/**/source*.kicad_mod binary
# RFC-style CSV records may use CRLF; their archived hashes remain unchanged.
*.csv whitespace=cr-at-eol
# This generated inventory report is retained verbatim with SHA256SUMS.
docs/platform/research/m5-hardware-inventory-2026-10-26/changes.md whitespace=-blank-at-eof
# LILYGO CAD keeps the upstream filenames and exact bytes.
web/platform/assets/lilygo-*/*.step binary
web/platform/assets/lilygo-*/*.stp binary
