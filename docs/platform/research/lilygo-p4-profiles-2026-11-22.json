  "items": [
    {
      "productId": "lilygo-t-display-p4",
      "boardId": "lilygo-t-display-p4",
      "name": "LILYGO T-Display-P4 V1.0 TFT",
      "chip": "esp32p4",
      "physicalChip": "ESP32-P4 + ESP32-C6",
      "flashMB": 16,
      "psramMB": 32,
      "hardwareRevision": "T-Display-P4 V1.0 TFT; simulator selects P4 silicon rev < 3, not V2.0 evaluation hardware",
      "runtimeLevel": "partial",
      "chronology": {
        "date": "2025-06-13",
        "basis": "hardware-release",
        "sourceUrl": "https://wiki.lilygo.cc/products/t-display-series/t-display-p4/",
        "sourceId": "official-wiki-t-display-p4",
        "confidence": "medium",
        "hardwareRevision": "T-Display-P4 V1.0",
        "notes": "Earliest dated hardware version explicitly listed in the official Version History. This is the manufacturer documentation date, not independently verified retail launch; undated and preview variants remain separate."
      },
      "display": {
        "width": 540,
        "height": 1168,
        "type": "LCD",
        "controller": "HI8561 / H0405S002T002-V0",
        "interface": "MIPI-DSI",
        "implemented": false,
        "physicalTouch": true,
        "touchImplemented": false
      },
      "controls": [
        {
          "id": "boot",
          "name": "P4 BOOT / GPIO35",
          "type": "button",
          "transport": "board",
          "pin": 35,
          "activeLow": true
        }
      ],
      "sdCard": {
        "slot": true,
        "transport": "sdmmc",
        "implemented": true,
        "pins": {
          "clk": 43,
          "cmd": 44,
          "d0": 39,
          "d1": 40,
          "d2": 41,
          "d3": 42
        },
        "defaultImageMiB": 64,
        "defaultFilesystem": "FAT32",
        "power": "Current SDMMC backend supplies a digital powered socket; XL9535 IO15 supply switching is not modeled."
      },
      "pins": {
        "boot": 35,
        "i2c0": {
          "sda": 7,
          "scl": 8,
          "xl9535": {
            "address": 32,
            "interrupt": 5,
            "implemented": "digital register subset"
          }
        },
        "i2c1": {
          "sda": 20,
          "scl": 21,
          "implemented": false
        },
        "c6Sdio": {
          "clk": 18,
          "cmd": 19,
          "data": [
            14,
            15,
            16,
            17
          ],
          "implemented": false
        }
      },
