  "semantics": {
    "alias": "Fixed header identifies ordinary GPIO function0 aliases; SPI2,Flash,JTAG,UART function0 remain unimplemented. Unbonded29/41excluded.",
    "samples": "Optional caller voltage for Drive::Unsupported only. It neither implements the peripheral nor changes Drive. Input disable still reads0; held configuration retains a live changing sample.",
    "priority": "KnownGPIO drive and external contention retain existing behavior. Samples cannot override those paths. Supplied external driver contradicting an unresolved sample is rejected.",
    "strict": "Absent samples remain Prohibited on unresolved enabled peripheral input. Invalid/unbonded pins and duplicateCLIinput are rejected.",
    "noInference": "No automatic Flash/UART idle values or new physical reset profile."
  },
  "fixture": {
    "path": "firmware/s31-uart-probe/gpio-input-probe.S",
    "runs": [
      "S31 GPIO sample mode=0 steps=2000 stop=Budget uart=\"S31 GPIO SAMPLE READY\\nS31 GPIO SAMPLE CHANGED PASS\\n\"",
      "S31 GPIO sample mode=1 steps=11 stop=Trap(Exception(5)) uart=\"\"",
      "S31 GPIO sample mode=2 steps=126 stop=Trap(Ebreak(788529278)) uart=\"S31 GPIO SAMPLE FAIL\\n\"",
      "S31 GPIO sample mode=3 steps=11 stop=Trap(Exception(5)) uart=\"\""
    ],
    "positive": "Actual guest configures GPIO36function0output high,reads GPIO32samplelow,waits forUARTA,thenreads high and reportsPASS. The line logs the first run steps/stop and totalUART after the second run.",
    "negative": "Missing sample and contradictory external driver fault before UART;wronginitiallevel enters actualFAILbranch."
  },
