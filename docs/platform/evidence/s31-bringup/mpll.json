  "firmwareSourceVersion": "Released image reports ESP-IDF v6.1-dirty; exact private build revision is not established. Public source comparison pinned to fff9895c82d744c7237be8847347bdd1b07c6643.",
  "semantics": {
    "power": "MPLL immediate ICG/I2C/circuit commands,active mode power policy and alive-root gate all required. Low commands invalidate output; contradictory high/low writes reject atomically. CPLL state stays independent.",
    "divider": "LP_MSPI_DIV reset0xc1: REF1 and FB24. Fixed LL formula40MHz*(FB+1)/2; unsupported reference/filter/charge-pump tuning rejects without mutation. Divider changes invalidate calibration.",
    "calibration": "Explicit clearSTOP starts a finite16private-quantum functional process. Progress requires real modeled MPLL power and analog-master clock. ROEND writes never inject completion. STOP preserves completed result but cancels pending work; poweroff clears both. This is not analog lock/waveform or silicon settling time.",
    "routing": "PSRAM_CTRL0 chooses actual XTAL/MPLL/CPLL roots per LL selector0/1/2 and integer divider. A selected unpowered/uncalibrated/gated root denies reads,writes and instruction fetches. PHY power and backing-memory/MMU checks remain independent. No implicit PSRAM chip or identity."
  },
  "fixture": {
    "path": "firmware/s31-uart-probe/mpll-probe.S",
    "runs": [
      "test external_s31_mpll_real_psram_code_with_power_clock_and_calibration_negatives ... S31 MPLL mode=0 steps=222 stop=Waiting mpll=Some(400000000) psram=Some(200000000) retired=1",
      "S31 MPLL mode=1 steps=2667 stop=Trap(Ebreak(788529430)) mpll=None psram=Some(40000000) retired=0",
      "S31 MPLL mode=2 steps=60 stop=Trap(Exception(7)) mpll=Some(400000000) psram=Some(200000000) retired=0",
      "S31 MPLL mode=3 steps=73 stop=Trap(Exception(1)) mpll=Some(400000000) psram=None retired=0",
      "S31 MPLL mode=4 steps=75 stop=Trap(Exception(1)) mpll=None psram=None retired=0",
      "S31 MPLL mode=5 steps=39 stop=Trap(Exception(7)) mpll=None psram=None retired=0"
    ],
    "positive": "Guest powers MPLL and PHY,enables analog master,programs400MHz,waits actual completion,selects MPLL/2 and writes two instructions to caller-provided PSRAM. Actual instruction fetch returns42 and emitsPASS; PC observer retires memory entry once.",
    "negative": "No analog clock takes guest timeout/FAIL. Missing PHY power traps store. PLL path gate or changed divider traps fetch. WrittenROdone with STOP cannot permit store. All negative entry retirement counts remain0."
  },
