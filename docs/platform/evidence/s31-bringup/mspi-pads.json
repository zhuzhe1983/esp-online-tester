  "firmwareSourceVersion": "Released image reports ESP-IDF v6.1-dirty; exact private build revision is not established. Public source comparison pinned to fff9895c82d744c7237be8847347bdd1b07c6643.",
  "semantics": {
    "layout": "Dedicated IOMUX_MSPI_PIN at0x20584000. Eleven pad registers0x1c..0x44; ordinary reset0x4000/mask0xffff,HOLD15. DQS0x3c reset0x20000/mask0x7fffff,HOLD22 and power-request0. Clock register0 reset1/mask1 is automatic gating policy,not a clock-off switch.",
    "hold": "RW register configuration remains readable/writable. Any held pad refuses real backing-memory store,load or instruction fetch. No frozen pin waveform or simultaneous-write sampling order is inferred. Release permits existing clock,PHY,MMU and backing-memory checks.",
    "dqs": "Configuration request only. Future DDR transaction checks additionally require it; current generic backing-memory path is not a DDR protocol. No attached die or inferred capacity.",
    "analog": "Drive,pull,hysteresis,phase and delay values are retained configuration,not verified signal timing,analog behavior or silicon tolerance."
  },
  "fixture": {
    "path": "firmware/s31-uart-probe/mspi-pads-probe.S",
    "runs": [
      "test external_s31_dedicated_mspi_pad_hold_and_release_control_real_memory_execution ... S31 MSPI pads mode=0 steps=199 stop=Waiting held=false retired=1",
      "S31 MSPI pads mode=1 steps=34 stop=Trap(Exception(7)) held=true retired=0",
      "S31 MSPI pads mode=2 steps=56 stop=Trap(Exception(1)) held=true retired=0",
      "S31 MSPI pads mode=3 steps=48 stop=Trap(Exception(5)) held=true retired=0"
    ],
    "positive": "Guest powers PHY,sets an MMU page,checks reset configuration,changes CS configuration while held,releases it,requests DQS,then writes/reads/fetches real instructions in caller-supplied64KiB memory. Code returns42 and emitsPASS; PC observer retires entry once.",
    "negative": "Held CS traps store7; held DQS traps fetch1; held data pin traps load5. Every negative has no UART or retired memory entry."
  },
