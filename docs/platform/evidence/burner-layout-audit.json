  "findings": [
    {
      "id": "no-v1-layout",
      "result": "The five projects and all their PUBLIC versions expose no app/full-image layout, flash offset, manifest or boot-mode field. Descriptions do not declare image layout."
    },
    {
      "id": "name-hint-only",
      "result": "Kaleidoscope v0.0.2 filename ends full-0x0.bin. This is a publisher filename hint, not a structured or verified layout declaration. Guru v3+ OTA support describes an updater feature, not the layout of the supplied download."
    },
    {
      "id": "normal-web-flash",
      "source": "FlashDialog-CZ7eefa6.js",
      "utf16Offset": 13701,
      "result": "Normal Burn downloads the selected BIN, optionally prepares configuration payloads, then adds the main image at flash address 0. No downloaded firmware-header app/full-image classifier was found in that path."
    },
    {
      "id": "shared-web-flash",
      "source": "DeveloperPage-BeJDDVKu.js",
      "utf16Offset": 5686,
      "result": "Shared Burn adds the downloaded image at address 0."
    },
    {
      "id": "plugin-not-image-offset",
      "source": "FlashDialog-CZ7eefa6.js",
      "utf16Offset": 24197,
      "result": "UIFLOW2_CFG replaces bytes 0x9000..0xf000 with generated NVS; UIFLOW_CFG appends configuration after the firmware; WIFI appends a block at image byteLength+4096 for ADDR_END, otherwise parses pluginAddr as a hex address. These fields control configuration data, not the main image start address."
    },
    {
      "id": "esptool-layout-preserved",
      "source": "esptool-DX1jy2gh.js",
      "utf16Offset": 127424,
      "result": "Wrapper passes each caller-provided address into esptool fileArray with flashSize/Mode/Freq keep; it does not derive a different firmware offset."
    }
  ],
  "recommendation": "Keep trusted explicit layout metadata highest priority where available. For these Burner downloads use actual binary structure validation; never treat pluginAddr or OTA support as an app offset. Retain user override and remember the selected mode. Do not patch UIFlow NVS or inject credentials merely because the original flasher can do it.",
  "privacy": "Response contents are reduced to field names, public product/version identifiers, source receipt and summarized behavior. Developer profiles, author data, private URLs, credentials and raw response contents are omitted."
}
