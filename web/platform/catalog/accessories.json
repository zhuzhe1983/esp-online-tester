      "schemaVersion": "1",
      "id": "m5stack-unit-angle-u005",
      "name": "M5Stack Unit Angle · U005",
      "manufacturer": "M5Stack",
      "sku": "U005",
      "hardwareRevision": "U005; official R1=10k transfer-curve profile, physical revision not identified",
      "type": "angle",
      "controller": "10kΩ potentiometer",
      "model": {
        "id": "potentiometer-u005-10k-curve",
        "status": "partial"
      },
      "parameters": {
        "position": 0.5
      },
      "connector": {
        "type": "HY2.0-4P",
        "voltage": 5,
        "pins": [
          {
            "color": "black",
            "name": "GND"
          },
          {
            "color": "red",
            "name": "5V"
          },
          {
            "color": "yellow",
            "name": "NC"
          },
          {
            "color": "white",
            "name": "ANALOG_OUT"
          }
        ]
      },
      "summary": "10kΩ 电位器旋钮模块，将角度转换为模拟电压。",
      "knowledgeUrl": "./knowledge/m5stack-unit-angle-u005.json",
      "dimensions": {
        "width": 24,
        "height": 32,
        "depth": 22,
        "unit": "mm",
        "sourceId": "official-docs"
      },
      "visual": {
        "status": "manufacturer-cad-shell",
        "modelUrl": "./assets/m5stack-unit-angle-u005/model.json",
        "limitations": [
          "已支持 StopWatch Port A 白线 G11 / ADC2_CH0：官方 10k 标称曲线，实际由客体 ADC 驱动采样；需客体开启 Grove 5V。",
          "官网两张电路图的 R1=4.7k/10k 不一致，三端绘法与所示公式也有差异；本模型明确采用公布的 Uo=5000mV×Rp/(Rp+10k)，不声称代表所有实物版次。",
          "输入 position/value 为 Rp/R2 的归一化值，机械转角和顺逆方向未实机校准；3D 转角仅作操作展示。",
          "断开和断电按 0V 数字边界处理；未模拟悬空噪声、阻抗、RC、ADC 非线性误差及实物校准。",
          "厂家 STL 保留原始尺寸，打印排版重复件已剔除；插座、螺钉及无 CAD 的外露部件为照片近似。",
          "未公开 PCB 布局，内部采用 UNKNOWN 占位；贴纸使用官方照片真实印刷区域。",
          "螺钉头纹和无厂家 CAD 的旋钮为简化，照片视角存在透视误差，不声称完整 1:1 通过。"
        ]
      },
