{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-accessory.schema.json",
  "title": "Private declarative accessory v1",
  "description": "A personal accessory definition, never executable JavaScript. Maximum UTF-8 JSON size: 16384 bytes. Public catalog entries have a separate catalog contract.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "type", "model", "parameters", "connector", "sources", "limitations"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "id": {"type": "string", "pattern": "^local:[a-z0-9][a-z0-9-]{0,69}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
    "description": {"type": "string", "maxLength": 2000},
    "type": {"enum": ["gps", "custom"]},
    "model": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["id", "status"], "properties": {"id": {"const": "uart-nmea"}, "status": {"const": "logical-input"}}},
      {"type": "object", "additionalProperties": false, "required": ["id", "status"], "properties": {"id": {"const": "metadata-only"}, "status": {"const": "unavailable"}}}
    ]},
    "parameters": {"$ref": "scene.schema.json#/$defs/parameters"},
    "connector": {"type": "object", "additionalProperties": false, "required": ["type", "voltage"], "properties": {"type": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S"}, "voltage": {"type": "number", "exclusiveMinimum": 0, "maximum": 48}, "protocol": {"enum": ["uart", "i2c", "gpio", "spi"]}, "pins": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["name", "direction"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "\\S"}, "direction": {"enum": ["input", "output", "bidirectional", "power", "ground"]}}}}}},
    "sources": {"type": "array", "items": {"type": "object", "required": ["title", "url"], "properties": {"title": {"type": "string"}, "url": {"$ref": "scene.schema.json#/$defs/url"}}}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [{"if": {"properties": {"model": {"properties": {"id": {"const": "uart-nmea"}}}}}, "then": {"properties": {"type": {"const": "gps"}}}}]
}
