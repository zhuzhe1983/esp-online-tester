      "id": "adapter-hardware",
      "label": "本次适配核对的硬件",
      "value": {
        "display": {
          "width": 180,
          "height": 640,
          "controller": "AXS15231B",
          "type": "TFT",
          "interface": "qspi",
          "pixelFormat": "RGB565",
          "physicalTouch": true,
          "touchImplemented": true
        },
        "flashMb": 16,
        "simulatedFlashMb": 16,
        "flashMbBasis": "verified-profile",
        "physicalPsramMb": 8,
        "controls": [
          {
            "id": "boot",
            "name": "BOOT",
            "type": "button",
            "pin": 0,
            "activeLow": true
          }
        ],
        "pins": {
          "boot": 0,
          "display": {
            "sclk": 17,
            "mosi": 13,
            "data": [
              13,
              18,
              21,
              14
            ],
            "cs": 12,
            "reset": 16,
            "backlight": {
              "pin": 1,
              "activeHigh": false
            },
            "ledcGate": true
          },
          "touch": {
            "controller": "AXS15231B",
            "address": 59,
            "sda": 15,
            "scl": 10,
            "irq": 11,
            "reset": 16,
            "resetSharedWithDisplay": true
          }
        }
      },
