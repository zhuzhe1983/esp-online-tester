      },
      "basis": "cad-measurement",
      "sourceIds": [
        "official-cad-stl"
      ],
      "unit": "source-coordinate-units",
      "notes": "STL does not declare units. These are raw mesh coordinates, not product dimensions. The 234.302... extent shows that the whole file must not be uniformly normalized as a single assembled device; isolate the intended geometry first.",
      "method": "Read little-endian uint32 facet count at byte 80; for each 50-byte binary STL facet, reduce the three float32 vertices to per-axis minima/maxima. No geometry scaling or component selection was applied."
    },
    {
      "id": "cad-components-and-units",
